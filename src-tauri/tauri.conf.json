{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO Panel",
  "version": "0.2.5",
  "identifier": "com.nexo.panel",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "NEXO — Panel de control",
        "width": 1100,
        "height": 760,
        "minWidth": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

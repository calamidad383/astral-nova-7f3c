# ===================================================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env real al repositorio.
# ===================================================================

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# --- IA ---
# La IA es local y autocontenida (ia/motor.py): NO necesita claves.
# Estas variables ya no se usan; se dejan por compatibilidad.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Base de datos ---
DATABASE_PATH=data/plataforma.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- PayPal (opcional: sin esto el panel de negocio muestra datos de ejemplo) ---
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Cola de tareas (fase 2) ---
REDIS_URL=
